include "BaseTypes.fbs";

namespace orbpro.propagator;

enum ReferenceFrame : ubyte {
  TEME = 0,
  J2000 = 1,
  ICRF = 2,
  ECEF = 3,
  MCI = 4,
  MCMF = 5
}

enum StateFlags : uint {
  NONE = 0,
  VALID = 1,
  IN_ECLIPSE = 2,
  DECAYED = 4,
  MANEUVERING = 8,
  EXTRAPOLATED = 16,
  HAS_COVARIANCE = 32
}

// Synced to the ratified SDS VCM.propagatorFamily vocabulary (schema/VCM/main.fbs)
// so any provider self-identifying in PropagatorDescribeSourcesBatchResult uses
// the SAME family codes SDS already carries — HPOP/Cowell-class numerical
// integrators map to COWELL (no HPOP-specific code needed); new codes go
// through Themis's SDS auto-ratification law, never invented here first.
enum PropagatorSourceKind : ubyte {
  NONE = 0,
  SEMI_ANALYTICAL = 1,
  VINTI = 2,
  SGP4 = 3,
  COWELL = 4,
  RK4 = 5,
  NYX = 6,
  GMAT = 7,
  SPICE = 8,
  SGP = 9,
  SDP4 = 10,
  SGP8 = 11,
  SDP8 = 12
}

struct StateVector {
  epoch:double;
  position:orbpro.Vec3;
  velocity:orbpro.Vec3;
  reference_frame:ReferenceFrame;
  flags:uint;
}

table PropagatorDescribeSourcesBatchRequest {
  catalogHandle:uint = 0;
  sourceHandles:[uint];
}

table PropagatorSourceDescription {
  sourceHandle:uint = 0;
  sourceKind:PropagatorSourceKind = NONE;
  objectName:string;
  objectId:string;
  noradCatId:uint = 0;
  epochJd:double = 0.0;
  meanMotionRevPerDay:double = 0.0;
  eccentricity:double = 0.0;
  inclinationDeg:double = 0.0;
  raOfAscNodeDeg:double = 0.0;
  argOfPericenterDeg:double = 0.0;
  meanAnomalyDeg:double = 0.0;
  ephemerisType:int = 0;
  classificationType:string;
  elementSetNo:uint = 0;
  revAtEpoch:uint = 0;
  bstar:double = 0.0;
  meanMotionDotRevPerDay2:double = 0.0;
  meanMotionDdotRevPerDay3:double = 0.0;
  perigeeKm:double = 0.0;
  apogeeKm:double = 0.0;
}

table PropagatorDescribeSourcesBatchResult {
  catalogHandle:uint = 0;
  sources:[PropagatorSourceDescription];
}

table PropagatorSampleTrajectoryStatesRequest {
  catalogHandle:uint = 0;
  sourceHandles:[uint];
  startJd:double = 0.0;
  durationDays:double = 0.0;
  profile:string;
}

table PropagatorSampleTrajectoryStatesResult {
  catalogHandle:uint = 0;
  startJd:double = 0.0;
  durationDays:double = 0.0;
  sampleJds:[double];
  sourceHandles:[uint];
  referenceFrame:ReferenceFrame = TEME;
  states:[StateVector];
}

root_type PropagatorDescribeSourcesBatchRequest;
