include "HostCallTypes.fbs";
namespace sdn.runtime;

/// The typed parameters of a host operation. OP names the operation; several operations share a parameter table
/// (IpfsCidParams for ipfs.cat / ls / pin_add / pin_rm / dag_get), so OP decides, PARAMS carries the values.
union HostCallParams {
  ClockNowParams,
  RandomBytesParams,
  HostInfoParams,
  HasCapabilityParams,
  NodeIdentityParams,
  GetConfigParams,
  HttpRequest,
  StorageQueryParams,
  StorageWriteParams,
  StorageDeleteParams,
  StorageExpireParams,
  StorageIngestParams,
  SqlStreamParams,
  EpochStreamParams,
  SandboxQueryParams,
  QuerySurfaceParams,
  CacheKeyParams,
  CryptoHashParams,
  CryptoPublicKeyParams,
  CryptoSignParams,
  CryptoVerifyParams,
  CryptoEncryptParams,
  CryptoDecryptParams,
  CryptoKeyAgreementParams,
  CryptoKdfParams,
  CryptoGenerateKeyParams,
  CryptoSealParams,
  CryptoOpenParams,
  IpfsAddParams,
  IpfsCidParams,
  IpfsPinLsParams,
  IpfsNameResolveParams,
  IpfsNamePublishParams,
  IpfsIdParams,
  IpfsSwarmPeersParams,
  PubsubPublishParams,
  PubsubTopicParams,
  PubsubListTopicsParams,
  ProtocolRequestParams,
  KeyslotSignParams,
  KeyslotUnwrapParams,
  SecretIdParams,
  SecretPutParams,
  P2pParams,
  NodeStatusParams,
  NodeActivityParams,
  TimersDelayParams,
  ScheduleParams,
  WebsocketExchangeParams,
  MqttParams,
  SocketRequestParams,
  FsPathParams,
  FsWriteParams,
  FsMkdirParams,
  FsRenameParams,
  ExecParams,
  ContextParams,
  ContextListScopesParams,
  ProtocolHandleParams,
  ProtocolDialParams
}

/// One call from a module to its host (the space_data_module_host bridge). Replaces the JSON meta + binary segments
/// envelope (hostcallWire.js); the host answers with one HostCallResult.
table HostCall {
  /// e.g. "storage.ingest_with_source", "http.request", "crypto.sign".
  OP: string (required);
  PARAMS: HostCallParams;
}

root_type HostCall;
file_identifier "HCLQ";
