// The typed parameters and results of every host operation a module calls (the hostcall envelope, typed-contracts
// 1.0, owner 2026-10-13: "flatbuffer SDS only"; no JSON forms). One table per operation's parameters and one per
// result shape; HostCall.fbs and HostCallResult.fbs carry them in unions. Bytes are [ubyte] everywhere (never base64);
// times are Unix milliseconds UTC; record streams are one [ubyte] of size-prefixed frames. An empty string or a zero
// means "not given" and the host applies the documented default.
include "RuntimeCommon.fbs";
include "HttpRequest.fbs";
include "HttpResponse.fbs";
include "ModuleConfig.fbs";
include "IngestRequest.fbs";
include "IngestResult.fbs";
namespace sdn.runtime;

// ---- shared values -------------------------------------------------------------------------------------------------

table Empty {}
table BoolValue { VALUE: bool; }
table BytesValue { DATA: [ubyte]; }
table TextValue { VALUE: string; }
table TextList { VALUES: [string]; }

/// Bytes the host keeps and a flow egress resolves later by TOKEN (deliver Ref): single use.
table BodyRef {
  TOKEN: uint64;
  SIZE: uint64;
  /// Frames in the stream; -1 when unknown.
  FRAMES: int64 = -1;
  /// FNV-1a 64 of the bytes, 16 hex digits.
  FNV1A64: string;
}

/// How a large result is delivered: inline bytes, or a BodyRef the egress resolves.
enum deliverMode : ubyte { Inline, Ref }

/// A query's result as an aligned, size-prefixed FlatBuffer frame stream (inline or by reference).
table RecordStream {
  ROWS: uint64;
  COLUMNS: uint32;
  STREAM: [ubyte];
  REF: BodyRef;
}

// ---- clock, host, node, config -------------------------------------------------------------------------------------

table ClockNowParams {}
table ClockNow {
  UNIX_MS: uint64;
  /// Milliseconds from a host-chosen origin that never goes back.
  MONOTONIC_MS: double;
  /// UNIX_MS as RFC 3339 (UTC).
  ISO: string;
}

table RandomBytesParams {
  /// 1..8192; 0 = 32. More than 8192 is refused (never clamped).
  LENGTH: uint32;
}

table HostInfoParams {}
table HostInfo {
  /// "server", "node", "browser".
  RUNTIME_TARGET: string;
  /// Capabilities granted to this module.
  CAPABILITIES: [string];
  /// Capabilities this host can grant.
  SUPPORTED_CAPABILITIES: [string];
  /// Every operation this host serves.
  OPERATIONS: [string];
}

table HasCapabilityParams { CAPABILITY: string (required); }

table NodeIdentityParams {}
table NodeIdentity {
  PEER_ID: string;
  PUBLIC_KEY_HEX: string;
}

table GetConfigParams {}

// ---- storage -------------------------------------------------------------------------------------------------------

table StorageQueryParams {
  SCHEMA: string (required);
  /// UTC day YYYY-MM-DD.
  DAY: string;
  ENTITY_ID: string;
  NORAD_CAT_ID: uint32;
  /// 0 = 100.
  LIMIT: uint32;
}

table StoredRecord {
  CID: string;
  ROW_ID: int64;
  PEER_ID: string;
  TIMESTAMP_MS: int64;
  DATA: [ubyte];
  SIGNATURE: [ubyte];
  TAGS: SourceTags;
  PRODUCER_PEER_ID: string;
  PRODUCER_PUBLIC_KEY: string;
  MATERIALIZED_MS: int64;
  LENGTH: uint32;
}
table StoredRecords { RECORDS: [StoredRecord]; }

/// One record (size-prefixed or bare); a stream of several is refused.
table StorageWriteParams {
  SCHEMA: string (required);
  DATA: [ubyte];
}
table StorageWriteResult { CID: string; }

table StorageDeleteParams {
  SCHEMA: string;
  CID: string (required);
}

/// A lane's records that arrived before BEFORE_MS, deleted through the store's record index.
table StorageExpireParams {
  SCHEMA: string (required);
  PROVIDER_ID: string;
  SOURCE_NAME: string;
  BEFORE_MS: uint64;
  /// Index page size; 0 = 500.
  BATCH: uint32;
  /// 0 = 100000.
  MAX_DELETES: uint32;
}
table StorageExpireResult {
  DELETED: uint64;
  /// Listed by the index, no longer stored.
  MISSING: uint64;
  /// Stopped at MAX_DELETES with more to go.
  CAPPED: bool;
}

/// One batch with its source tags: REQUEST says what it is, RECORDS is the size-prefixed record stream, ARCHIVE_RAW
/// the source document when REQUEST.ARCHIVE names a target.
table StorageIngestParams {
  REQUEST: IngestRequest (required);
  RECORDS: [ubyte];
  ARCHIVE_RAW: [ubyte];
}

enum sqlValueKind : ubyte { Null, Bool, I64, F64, Str, Bytes }
/// One SQL parameter or result value.
table SqlValue {
  KIND: sqlValueKind;
  BOOL_VALUE: bool;
  I64_VALUE: int64;
  F64_VALUE: double;
  STR_VALUE: string;
  BYTES_VALUE: [ubyte];
}
table SqlRow { VALUES: [SqlValue]; }

table SqlStreamParams {
  SQL: string (required);
  PARAMS: [SqlValue];
  DELIVER: deliverMode;
}

table EpochStreamParams {
  /// Empty = "OMM.fbs".
  SCHEMA: string;
  SOURCE: string;
  /// Empty = "nearest".
  PROFILE: string;
  /// Unix seconds.
  EPOCH: double;
  /// 0 = 50000.
  LIMIT: uint32;
  DELIVER: deliverMode;
}

enum sandboxWant : ubyte { Stream, Rows, Auto }
table SandboxQueryParams {
  SQL: string (required);
  PARAMS: [SqlValue];
  WANT: sandboxWant;
  DELIVER: deliverMode;
}
/// A sandboxed query's answer: a record stream (KIND Stream) or typed rows (KIND Rows).
table SandboxQueryResult {
  KIND: sandboxWant;
  ROWS: uint64;
  COLUMNS: uint32;
  STREAM: [ubyte];
  REF: BodyRef;
  COLUMN_NAMES: [string];
  ROW_VALUES: [SqlRow];
}

table QuerySurfaceParams {}
table SurfaceTable {
  NAME: string;
  /// "view" or "table".
  KIND: string;
  SOURCE: string;
  COLUMNS: [string];
  PLACEHOLDER_COLUMNS: [string];
  RECORDS: int64;
}
table QuerySurface {
  TABLES: [SurfaceTable];
  TIMEOUT_MS: uint32;
  MAX_ROWS: uint64;
  MAX_BYTES: uint64;
}

table CacheKeyParams {
  SQL: string (required);
  PARAMS: [SqlValue];
  SCHEMA_NAME: string;
  SCHEMA_VERSION: string;
  FORMAT: string;
  PUBLISH_EVENT_KEY: string;
  PROJECTION: [string];
}

// ---- crypto (one family for every host) ----------------------------------------------------------------------------

enum cryptoAlgorithm : ubyte {
  Ed25519,
  /// ECDSA over secp256k1, signing SHA-256(DATA); DER signatures.
  Secp256k1,
  /// ECDSA over secp256k1, DATA is the 32-byte digest itself.
  Secp256k1Digest,
  X25519,
  Sha256,
  Sha512,
  Aes256Gcm,
  HkdfSha256
}

table CryptoHashParams { ALGORITHM: cryptoAlgorithm = Sha256; DATA: [ubyte]; }
table CryptoPublicKeyParams { ALGORITHM: cryptoAlgorithm; PRIVATE_KEY: [ubyte]; }
table CryptoSignParams { ALGORITHM: cryptoAlgorithm; PRIVATE_KEY: [ubyte]; DATA: [ubyte]; }
table CryptoVerifyParams { ALGORITHM: cryptoAlgorithm; PUBLIC_KEY: [ubyte]; DATA: [ubyte]; SIGNATURE: [ubyte]; }
/// NONCE: 12 bytes, or empty for a random one (returned).
table CryptoEncryptParams { ALGORITHM: cryptoAlgorithm = Aes256Gcm; KEY: [ubyte]; NONCE: [ubyte]; DATA: [ubyte]; AAD: [ubyte]; }
table CryptoCiphertext { CIPHERTEXT: [ubyte]; NONCE: [ubyte]; }
table CryptoDecryptParams { ALGORITHM: cryptoAlgorithm = Aes256Gcm; KEY: [ubyte]; NONCE: [ubyte]; CIPHERTEXT: [ubyte]; AAD: [ubyte]; }
table CryptoKeyAgreementParams { ALGORITHM: cryptoAlgorithm = X25519; PRIVATE_KEY: [ubyte]; PUBLIC_KEY: [ubyte]; }
/// LENGTH 1..512; 0 = 32.
table CryptoKdfParams { ALGORITHM: cryptoAlgorithm = HkdfSha256; IKM: [ubyte]; SALT: [ubyte]; INFO: [ubyte]; LENGTH: uint32; }
table CryptoGenerateKeyParams { ALGORITHM: cryptoAlgorithm; }
table CryptoKeyPair { PRIVATE_KEY: [ubyte]; PUBLIC_KEY: [ubyte]; }
/// X25519 sealed box for a recipient's public key, and its opening.
table CryptoSealParams { RECIPIENT_PUBLIC_KEY: [ubyte]; DATA: [ubyte]; }
table CryptoOpenParams { PRIVATE_KEY: [ubyte]; ENVELOPE: [ubyte]; }

// ---- ipfs ----------------------------------------------------------------------------------------------------------

table IpfsAddParams { DATA: [ubyte]; PIN: bool = true; }
table IpfsAddResult { CID: string; NAME: string; SIZE: uint64; }
/// ipfs.cat, ipfs.ls, ipfs.pin_add, ipfs.pin_rm, ipfs.dag_get.
table IpfsCidParams { CID: string (required); }
table IpfsLink { NAME: string; CID: string; SIZE: uint64; TYPE: int32; }
table IpfsLinks { LINKS: [IpfsLink]; }
table IpfsPinLsParams { TYPE: string; }
table IpfsPin { CID: string; TYPE: string; }
table IpfsPins { PINS: [IpfsPin]; }
table IpfsNameResolveParams { NAME: string (required); }
table IpfsNamePublishParams { CID: string (required); LIFETIME: string; TTL: string; }
table IpfsNamePublished { NAME: string; VALUE: string; }
table IpfsIdParams {}
table IpfsIdentity { ID: string; PUBLIC_KEY: string; ADDRESSES: [string]; AGENT_VERSION: string; PROTOCOL_VERSION: string; }
table IpfsSwarmPeersParams {}
table IpfsSwarmPeer { PEER_ID: string; ADDRESS: string; LATENCY_MS: double; }
table IpfsSwarmPeers { PEERS: [IpfsSwarmPeer]; }

// ---- pubsub --------------------------------------------------------------------------------------------------------

table PubsubPublishParams { TOPIC: string (required); DATA: [ubyte]; }
/// pubsub.subscribe, pubsub.unsubscribe.
table PubsubTopicParams { TOPIC: string (required); }
table PubsubSubscribed { TOPIC: string; ALREADY: bool; }
table PubsubListTopicsParams {}

// ---- protocol, keyslot, secrets ------------------------------------------------------------------------------------

table ProtocolRequestParams {
  /// A peer id or a /.../p2p/<id> multiaddr.
  TARGET: string (required);
  PROTOCOL_ID: string (required);
  PAYLOAD: [ubyte];
  /// 0 = 15000.
  TIMEOUT_MS: uint32;
}

table KeyslotSignParams { SLOT_ID: string (required); ALGORITHM: cryptoAlgorithm = Ed25519; PAYLOAD: [ubyte]; }
/// X25519 + HKDF-SHA256 ("sdn-server/keyslot.unwrap/v1") + AES-256-GCM.
table KeyslotUnwrapParams { SLOT_ID: string (required); EPHEMERAL_PUBLIC_KEY: [ubyte]; NONCE: [ubyte]; CIPHERTEXT: [ubyte]; }

/// secrets.get, secrets.status, secrets.clear.
table SecretIdParams { ID: string (required); }
table Secret { ID: string; USERNAME: string; SECRET: string; }
table SecretStatus { ID: string; CONFIGURED: bool; USERNAME_MASKED: string; UPDATED_MS: uint64; VERIFIED_MS: uint64; }
table SecretPutParams { ID: string (required); USERNAME: string; SECRET: string; }
table SecretStored { ID: string; UPDATED_MS: uint64; }

// ---- p2p -----------------------------------------------------------------------------------------------------------

/// p2p.peers_snapshot, p2p.standards_snapshot, p2p.pnm_history, p2p.latest_dataset.
table P2pParams {
  PEER_ID: string;
  /// 0 = unbounded.
  LIMIT: uint32;
  STANDARD: string;
  DELIVER: deliverMode;
}
table P2pPeer {
  PEER_ID: string;
  ADDRS: [string];
  CONNECTED: bool;
  SELF: bool;
  STANDARDS: [string];
  /// Index of the peer's $EPM frame in RECORDS; -1 = none.
  EPM_INDEX: int32 = -1;
  AGENT_VERSION: string;
}
/// RECORDS: the peers' $EPM frames, size-prefixed, concatenated.
table P2pPeersSnapshot { SELF: string; PEERS: [P2pPeer]; RECORDS: [ubyte]; }
table P2pStandardEntry {
  PEER_ID: string;
  STANDARD: string;
  SCHEMA: string;
  FILE_ID: string;
  FILE_NAME: string;
  CID: string;
  PUBLISH_MS: uint64;
  PNM_INDEX: int32 = -1;
}
/// RECORDS: the $PNM frames, size-prefixed, concatenated.
table P2pStandardsSnapshot { ENTRIES: [P2pStandardEntry]; RECORDS: [ubyte]; }
table P2pPnmEntry {
  PUBLISHER_PEER_ID: string;
  GOSSIP_PEER_ID: string;
  STANDARD: string;
  SCHEMA: string;
  FILE_ID: string;
  FILE_NAME: string;
  CID: string;
  PUBLISH_MS: uint64;
  SIGNATURE_TYPE: string;
  SIGNATURE: [ubyte];
  SIGNATURE_VERIFIED: bool;
  /// "signature" or "gossip".
  ATTRIBUTION: string;
  PNM_INDEX: int32 = -1;
  PUBLISHER_KEY: [ubyte];
  PUBLISHER_KEY_SOURCE: string;
}
table P2pPnmHistory {
  PEER_ID: string;
  PUBLISHER_KEY_AVAILABLE: bool;
  GOSSIP_ONLY_EXCLUDED: uint32;
  ENTRIES: [P2pPnmEntry];
  RECORDS: [ubyte];
}
table P2pPnmRef {
  CID: string;
  FILE_ID: string;
  PUBLISH_MS: uint64;
  BATCH_ID: string;
  STANDARD: string;
  SCHEMA: string;
  SIGNATURE_VERIFIED: bool;
  ATTRIBUTION: string;
}
table P2pServing {
  BATCH_ID: string;
  PROVIDER_ID: string;
  SOURCE_NAME: string;
  RECORD_COUNT: uint64;
  BYTE_COUNT: uint64;
  PARTS: uint32;
  PUBLISHED_MS: uint64;
  PNM: P2pPnmRef;
  ETAG_FNV1A64: string;
  STREAM: [ubyte];
  REF: BodyRef;
}
table P2pLatestDataset {
  KNOWN: bool;
  /// unknown-standard, no-publications, not-pinned, not-materialized; empty when served.
  REASON: string;
  PINNED: bool;
  SELF: bool;
  STANDARD: string;
  SCHEMA: string;
  PNM: P2pPnmRef;
  FRESH: bool;
  SERVING: P2pServing;
}

// ---- node status and activity --------------------------------------------------------------------------------------

table NodeStatusParams {}
table NodeBandwidthSample { TS_MS: uint64; TOTAL_IN_BYTES: uint64; TOTAL_OUT_BYTES: uint64; RATE_IN_BPS: double; RATE_OUT_BPS: double; }
table NodeBandwidth { TOTAL_IN_BYTES: uint64; TOTAL_OUT_BYTES: uint64; RATE_IN_BPS: double; RATE_OUT_BPS: double; HISTORY: [NodeBandwidthSample]; }
table NodeStatusReport {
  UPTIME_S: uint64;
  STARTED_MS: uint64;
  STORE_TOTAL_BYTES: uint64;
  STORE_TOTAL_RECORDS: uint64;
  STORAGE_PATH: string;
  HAS_DISK: bool;
  DISK_CAPACITY_BYTES: uint64;
  DISK_FREE_BYTES: uint64;
  DISK_AVAILABLE_BYTES: uint64;
  SERVICE_STATE: string;
  SERVICE_MODE: string;
  BANDWIDTH: NodeBandwidth;
}
/// 0 = 50; at most 256.
table NodeActivityParams { LIMIT: uint32; }
table NodeActivityEvent { TS_MS: uint64; KIND: string; DETAIL: string; PEER_ID: string; }
table NodeActivity { EVENTS: [NodeActivityEvent]; }

// ---- timers and schedule (SDK JS hosts) ----------------------------------------------------------------------------

table TimersDelayParams { MS: uint32; }

/// schedule.parse, schedule.matches (AT_MS: the instant to test; 0 = now), schedule.next (AT_MS: from; 0 = now).
table ScheduleParams { EXPRESSION: string (required); AT_MS: uint64; }
table CronField { SOURCE: string; VALUES: [int32]; HAS_WILDCARD: bool; }
table ScheduleParsed { EXPRESSION: string; MINUTE: CronField; HOUR: CronField; DAY_OF_MONTH: CronField; MONTH: CronField; DAY_OF_WEEK: CronField; }
table TimeValue { UNIX_MS: uint64; }

// ---- sockets, websocket, mqtt (SDK JS hosts) -----------------------------------------------------------------------

/// websocket.exchange: MESSAGE sent on open (as text when MESSAGE_IS_TEXT); the first message answered is BODY.
table WebsocketExchangeParams {
  URL: string (required);
  PROTOCOLS: [string];
  MESSAGE: [ubyte];
  MESSAGE_IS_TEXT: bool;
  TIMEOUT_MS: uint32;
  EXPECT_RESPONSE: bool = true;
}
table WebsocketExchange {
  URL: string;
  PROTOCOL: string;
  EXTENSIONS: string;
  /// -1 = the socket did not close.
  CLOSE_CODE: int32 = -1;
  CLOSE_REASON: string;
  BODY: [ubyte];
  BODY_IS_TEXT: bool;
}

/// mqtt.publish (PAYLOAD) and mqtt.subscribe_once (PACKET_ID): MQTT 3.1.1, QoS 0.
table MqttParams {
  HOST: string (required);
  PORT: uint16;
  CLIENT_ID: string;
  TOPIC: string (required);
  PAYLOAD: [ubyte];
  USERNAME: string;
  PASSWORD: string;
  /// 0 = 30.
  KEEP_ALIVE_S: uint16;
  TIMEOUT_MS: uint32;
  /// 0 = 1.
  PACKET_ID: uint16;
}
table MqttPublished { HOST: string; PORT: uint16; CLIENT_ID: string; TOPIC: string; PAYLOAD_BYTES: uint64; }
table MqttMessage { HOST: string; PORT: uint16; CLIENT_ID: string; TOPIC: string; BODY: [ubyte]; }

/// tcp.request, udp.request, tls.request: DATA sent, the answer collected until close (TCP/TLS) or the first datagram
/// (UDP). The TLS fields apply to tls.request only.
table SocketRequestParams {
  HOST: string (required);
  PORT: uint16;
  DATA: [ubyte];
  TIMEOUT_MS: uint32;
  EXPECT_RESPONSE: bool = true;
  BIND_ADDRESS: string;
  BIND_PORT: uint16;
  /// "udp4" (default) or "udp6".
  UDP_TYPE: string;
  CA: [ubyte];
  CERT: [ubyte];
  KEY: [ubyte];
  REJECT_UNAUTHORIZED: bool = true;
  SERVER_NAME: string;
}
table SocketResponse {
  HOST: string;
  PORT: uint16;
  LOCAL_ADDRESS: string;
  LOCAL_PORT: uint16;
  REMOTE_ADDRESS: string;
  REMOTE_PORT: uint16;
  BODY: [ubyte];
  AUTHORIZED: bool;
  AUTHORIZATION_ERROR: string;
}

// ---- filesystem, exec, context (SDK JS hosts) ----------------------------------------------------------------------

/// filesystem.resolve_path, read_file, delete_file, readdir, stat: PATH within the host's filesystem root.
table FsPathParams { PATH: string; }
/// filesystem.write_file / append_file.
table FsWriteParams { PATH: string (required); DATA: [ubyte]; APPEND: bool; }
table FsMkdirParams { PATH: string (required); RECURSIVE: bool = true; }
table FsRenameParams { FROM_PATH: string (required); TO_PATH: string (required); }
table FsEntry { NAME: string; IS_FILE: bool; IS_DIRECTORY: bool; }
table FsEntries { ENTRIES: [FsEntry]; }
table FsStat { PATH: string; SIZE: uint64; IS_FILE: bool; IS_DIRECTORY: bool; CTIME_MS: double; MTIME_MS: double; }

/// exec.exec_file: FILE must be on the host's allowlist; ENV entries are merged over the host's environment.
table ExecParams {
  FILE: string (required);
  ARGS: [string];
  CWD: string;
  ENV: [Header];
  INPUT: [ubyte];
  TIMEOUT_MS: uint32;
}
table ExecResult { EXIT_CODE: int32 = -1; SIGNAL: string; STDOUT: [ubyte]; STDERR: [ubyte]; }

/// context.get / set / delete / list_keys: a value is bytes the module chooses (a typed FlatBuffer). SCOPE empty =
/// "global".
table ContextParams { SCOPE: string; KEY: string; VALUE: [ubyte]; }
table ContextListScopesParams {}
table ContextValue { FOUND: bool; VALUE: [ubyte]; }

// ---- protocol handle and dial (SDK JS hosts) -----------------------------------------------------------------------

table ProtocolHandleParams { PROTOCOL_ID: string (required); }
table ProtocolDialParams { PROTOCOL_ID: string (required); PEER_ID: string (required); }
